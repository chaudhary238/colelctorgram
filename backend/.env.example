# ── Database ──────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/collectohub
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/collectohub

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Meilisearch ───────────────────────────────────────────────────
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=masterKey

# ── Auth (JWT) ────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── OAuth (Google) ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ── Cloudflare R2 ─────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=collectohub-media
R2_PUBLIC_URL=https://cdn.collectohub.com

# ── Expo Push ─────────────────────────────────────────────────────
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# ── App ───────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
FRONTEND_URL=http://localhost:3000
